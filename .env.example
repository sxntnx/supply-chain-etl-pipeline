# Copy this file to .env and fill in your own values. Never commit .env.

# Storage backend: "sqlite" (local file, no setup) or "postgres" (Neon).
DB_BACKEND=postgres

# SQLAlchemy connection string for the PostgreSQL backend.
# Neon Console -> your project -> Connect -> copy the connection string,
# then prefix the driver as shown below.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Rows per INSERT batch when loading over the network.
LOAD_CHUNK_SIZE=10000
